generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url    = "file:./dev.db"
}

model Booking {
  id        Int      @id @default(autoincrement())
  guests    Int
  date      String
  time      String
  email     String   @default("")
  status    String   @default("new")
  createdAt DateTime @default(now())
}
