generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  
  url = env("DATABASE_URL") // для приложения (pooler)
  directUrl = env("DIRECT_URL") // для миграций (прямое подключение)
  
}

model Booking {
  id        Int      @id @default(autoincrement())
  guests    Int
  date      String
  time      String
  duration Int @default(120) // PR6 6.2
  email     String   @default("")
  status    String   @default("new")
  isRead    Boolean @default(false) // NEW PR6
  tableId Int? // PR6 6.2
  table Table? @relation(fields: [tableId], references: [id]) // PR6 6.2
  createdAt DateTime @default(now())
  
  // ==
  // НОВОЕ ИЗМЕНЕНИЕ: Уникальный индекс на (date, time) (2.10)
  // tg 2 changes PR2 2.10
  //
  // ЗАЧЕМ:
  // Предотвращает race condition — два одновременных запроса
  // не смогут создать две брони на одно время.
  //
  // БД проверит сама: если пара (date, time) уже существует —
  // второй INSERT упадёт с ошибкой P2002.
  //
  // ОГРАНИЧЕНИЕ:
  // Этот индекс блокирует ВСЕ дубли, включая cancelled.
  // В будущем (PR 6) можно улучшить — учитывать только
  // активные брони (new, confirmed).
  // ===
  @@unique([date, time])
  @@index([date, time]) // PR6 6.2
}


// PR6 6.2 НОВОЕ!!

model Table {
  id Int @id @default(autoincrement())
  number Int @unique
  capacity Int // 2, 4, 6, 8

  // Позиция на схеме зала (проценты от контейнера 0–100). PR6 6.6
  // posX/posY — центр стола, а не левый верхний угол.
  posX  Int @default(50)
  posY  Int @default(50)

  // Форма стола на виде сверху: PR6 6.6
  // round | square | rect-wide | rect-large
  // Форма стола на виде сверху:
  // round      — круглый    (2 места)
  // square     — квадратный (4 места)
  // rect-wide  — вытянутый  (6 мест)
  // rect-large — большой    (8 мест)
  shape String  @default("react-wide")

  // Поворот в градусах: 0 | 90 | 180 | 270 PR6 6.6
  rotation Int  @default(0)

  isBlocked Boolean @default(false) // NEW

  bookings Booking[]

  @@index([capacity])
}

