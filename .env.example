# ПАРОЛЬ В АДМИНКУ
ADMIN_PASSWORD=

# ПОЧТА, КУДА ПРИХОДЯТ УВЕДОМЛЕНИЯ О НОВОЙ БРОНИ ИСПОЛЬЗУЕТСЯ В booking.js и updateStatus.js
MY_EMAIL=

# API-КЛЮЧ RESEND ДЛЯ ОТПРАВКИ ПИСЕМ.
# СНАЧАЛА ПРОВЕРЯЕТ process.env (ДЛЯ ДЕПЛОЯ НА VERCEL), ЕСЛИ НЕТ — ИСПОЛЬЗУЕТ ЗАПАСНОЙ
RESEND_KEY=

# ТОКЕН И CHAT_ID ДЛЯ ОТПРАВКИ УВЕДОМЛЕНИЙ В TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=